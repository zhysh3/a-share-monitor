# 复制本文件为 .env 后填写（cp .env.example .env）
#
# 妙想 API key（东方财富付费接口，可选）。有就填在等号后面（不要加引号），没有就留空。
# 留空时社融数据走央行官网直连 + AKShare 回退，功能不受影响。
# 获取地址：https://dl.dfcfs.com/m/itc4
export MX_APIKEY=

# ── moomoo 行情（OpenAPI / OpenD 网关）─────────────────────
# 指数日K、成交额、ETF 现价、盘中快照都走 moomoo OpenD。
# 前置：pip install moomoo-api，并在本机启动 moomoo OpenD 登录账号（需沪深 LV1 行情权限）。
# OpenD 没开也能跑：行情自动回退 AKShare/新浪，只是成交额为经验系数估算。
export MOOMOO_HOST=127.0.0.1
export MOOMOO_PORT=11111
# 设为 0 可强制关掉 moomoo，全部走 AKShare 回退
export MOOMOO_ENABLED=1
